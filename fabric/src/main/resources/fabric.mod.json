{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}+${minecraft_version_slug}+fabric",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": [
    "LGPL-3.0-or-later",
    "MIT"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.tbsu.stackupgrades.StackUpgrades"
    ]
  },
  "mixins": [
    "tbstackupgrades.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range_fabric}",
    "java": ">=25",
    "travelersbackpack": ">=11.4.0"
  },
  "icon": "assets/tbstackupgrades/icon.png"
}
